generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TodoStatus {
  pending
  in_progress
  completed
}

model Todo {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TodoStatus @default(pending)
  userId      String
  createdAt   Int
  updatedAt   Int
  dueAt       Int?
}
