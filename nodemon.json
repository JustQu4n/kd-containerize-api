{
  "watch": ["src"],
  "ext": "ts,json",
  "ignore": ["src/**/*.spec.ts"],
  "exec": "ts-node -r tsconfig-paths/register --transpile-only",
  "execMap": {
    "ts": "ts-node --transpile-only"
  },
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 500,
  "verbose": true,
  "signal": "SIGTERM"
}
