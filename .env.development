# ═══════════════════════════════════════════════════════════
# Full Todo API - Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and update values for your environment

# ─── APPLICATION ─────────────────────────────────────────
# Environment: development | staging | production
NODE_ENV=development

# Server port
PORT=3000

# Log level: debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── DATABASE ────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?schema=public
# For Docker Compose: use 'postgres' as hostname
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/todos?schema=public"

# ─── AUTHENTICATION ──────────────────────────────────────
# JWT signing secret (MUST be at least 32 characters)
# For development, use the default. For production, generate a secure value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-key-min-32-characters-required-!!"

# JWT token expiry
JWT_EXPIRY=24h

# ─── CORS ────────────────────────────────────────────────
# Allowed origin for CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# ─── RATE LIMITING ───────────────────────────────────────
# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window per IP
RATE_LIMIT_MAX_REQUESTS=100

# ═══════════════════════════════════════════════════════════
# IMPORTANT NOTES:
# ═══════════════════════════════════════════════════════════
# 1. Never commit .env file to Git (it's in .gitignore)
# 2. For production, use GitHub Secrets to provide sensitive values
# 3. Generate new JWT_SECRET for production
# 4. Use strong database password for production
# 5. Set NODE_ENV=production in production
# ═══════════════════════════════════════════════════════════
